# =====================================================================
# BillEasy defaults for docker compose.
#
# Copy to .env and change the values before exposing this stack:
#   Copy-Item .env.example .env
# =====================================================================

# Password for the MySQL root user (shared by all five database containers).
MYSQL_PASSWORD=billeasy_root

# Shared JWT signing secret. Must be identical for every service + web.
JWT_SECRET=billeasy-super-secret-key-2026
