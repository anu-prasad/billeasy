# Dependencies (installed inside the image)
node_modules
**/node_modules

# Build output (rebuilt inside the image)
.next
**/.next
out
tsconfig.tsbuildinfo

# Version control
.git
.gitattributes
.gitignore

# Local env files — never bake secrets into images.
# Config is passed at runtime via docker-compose (environment:) instead.
.env
.env.*
**/.env
**/.env.*
!**/.env.example

# Logs & debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS / editor noise
.DS_Store
Thumbs.db

# Docs & dev tooling (not needed inside images)
README.md
CLAUDE.md
AGENTS.md
docker-compose.yml
Dockerfile
